# Copy to .env and adjust before running `docker compose up`

# Postgres
POSTGRES_USER=sensir
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sensir
DATABASE_URL=postgresql+psycopg2://sensir:change-me@postgres:5432/sensir

# MQTT (Mosquitto broker, PoC start: username/password auth, no TLS)
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USERNAME=sensir
MQTT_PASSWORD=change-me
# Topic pattern Tasmota IR bridges publish to: tele/<sensor-topic>/RESULT
MQTT_RESULT_TOPIC_FILTERS=tele/+/RESULT,stat/+/RESULT

# Telegram bot used for alerting contacts (create via @BotFather)
TELEGRAM_BOT_TOKEN=

# Alerting / observation window defaults (used until a household has enough
# history for the ML model to take over, see backend/app/ml/window_model.py)
CHECK_INTERVAL_MINUTES=15
DEFAULT_WINDOW_START=18:00
DEFAULT_WINDOW_END=24:00
DEFAULT_MIN_ACTIONS=2
ML_MIN_SAMPLES=200
ML_TRAIN_HOUR_UTC=3
