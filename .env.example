# Copy to .env and adjust before running `docker compose up`

# Postgres
POSTGRES_USER=sensir
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sensir
DATABASE_URL=postgresql+psycopg2://sensir:change-me@postgres:5432/sensir

# ============================================================
# Quelle 1: IR-Bridge über MQTT (Pearl/Tasmota)
#   Kein selbstgehosteter Broker im Compose-Stack mehr (siehe sensir.md
#   4.1) - die IR-Bridges hängen in verschiedenen, entfernten Haushalten
#   ohne Port-Forwarding zur Synology. Stattdessen ein von außen
#   erreichbarer MQTT-Broker (hier: eigener Broker hinter DynDNS), zu
#   dem sowohl die Tasmota-Geräte als auch dieses Backend als Client
#   ausgehend verbinden.
# ============================================================
MQTT_ENABLED=true
MQTT_HOST=your-broker.example.com
MQTT_PORT=1883
MQTT_USERNAME=change-me
MQTT_PASSWORD=change-me
MQTT_RESULT_TOPIC_FILTERS=tele/+/RESULT,stat/+/RESULT

# ============================================================
# Quelle 2: Tuya / SmartLife über die Tuya Cloud
#   iot.tuya.com -> Cloud-Projekt -> SmartLife-Konto verknüpfen
# ============================================================
TUYA_ENABLED=false
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
TUYA_REGION=eu
TUYA_APP_ACCOUNT_UID=
TUYA_PULSAR_ENABLED=true
# Ablaufdatum des Tuya-IoT-Core-Trial-Abos - kein API-Feld dafür verfügbar,
# nach jedem "Extend Trial Period" auf iot.tuya.com hier nachtragen (YYYY-MM-DD),
# dann warnt das Dashboard rechtzeitig vorher. Leer lassen = keine Erinnerung.
TUYA_TRIAL_EXPIRES=
TUYA_TRIAL_WARN_DAYS_BEFORE=14

# ============================================================
# Quelle 3: Shelly über die Shelly Cloud
#   Shelly-App/Cloud -> Einstellungen -> Autorisierungs-Cloud-Key
#   (dort steht auch der Server-Host)
# ============================================================
SHELLY_ENABLED=false
SHELLY_AUTH_KEY=
SHELLY_API_HOST=https://shelly-eu.shelly.cloud
SHELLY_WS_ENABLED=true

# gemeinsames Poll-Intervall für Tuya + Shelly (Fallback zum Echtzeit-Stream)
SOURCE_POLL_INTERVAL_SECONDS=120

# ============================================================
# Alerting
# ============================================================
TELEGRAM_BOT_TOKEN=

CHECK_INTERVAL_MINUTES=15
DEFAULT_WINDOW_START=18:00
DEFAULT_WINDOW_END=23:59
DEFAULT_MIN_ACTIONS=2
ML_MIN_SAMPLES=200
ML_TRAIN_HOUR_UTC=3

# Wöchentlicher CSV-Rohdaten-Export (für eigenes ML-Training) an die
# Telegram-Kontakte jedes Haushalts
WEEKLY_EXPORT_ENABLED=true
WEEKLY_EXPORT_DAY_OF_WEEK=sun
WEEKLY_EXPORT_HOUR_UTC=5
